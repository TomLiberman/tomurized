{
  "name": "tomurized",
  "private": true,
  "version": "1.0.0",
  "description": "Self-hosted study portal: spaced-repetition flashcards (FSRS), practice exams, study games and an AI mentor for any course. Hebrew (RTL) and English.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomLiberman/tomurized.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix server",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/src/index.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && npm run typecheck --prefix server"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@fontsource-variable/heebo": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
